// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Management Models
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String   @default("") // Hashed password
  displayName String
  avatar      String?
  role        UserRole @default(USER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  preferences UserPreferences?
  votes       Vote[]
  comments    Comment[]
  donations   Donation[]

  @@map("users")
}

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Notification preferences
  emailNotifications    Boolean @default(true)
  pushNotifications     Boolean @default(true)
  commentNotifications  Boolean @default(true)
  newContentNotifications Boolean @default(true)
  pollNotifications     Boolean @default(true)

  // Privacy preferences
  showProfile     Boolean @default(true)
  allowMentions   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

// Content Management Models
model ContentSection {
  id          String             @id @default(cuid())
  type        ContentSectionType
  title       String
  content     String
  metadata    Json?
  isPublished Boolean            @default(false)
  publishedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Relations
  images   ContentImage[]

  @@map("content_sections")
}

model ContentImage {
  id               String         @id @default(cuid())
  contentSectionId String
  contentSection   ContentSection @relation(fields: [contentSectionId], references: [id], onDelete: Cascade)

  url     String
  altText String
  caption String?
  order   Int    @default(0)

  // Image metadata
  width  Int
  height Int
  format String
  size   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("content_images")
}

model Outfit {
  id          String  @id @default(cuid())
  title       String
  description String?
  occasion    String?
  season      String?
  isFavorite  Boolean @default(false)
  isOutfitOfMonth Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items    OutfitItem[]
  images   OutfitImage[]

  @@map("outfits")
}

model OutfitItem {
  id       String           @id @default(cuid())
  outfitId String
  outfit   Outfit           @relation(fields: [outfitId], references: [id], onDelete: Cascade)

  name        String
  brand       String?
  category    OutfitItemCategory
  color       String
  purchaseUrl String?
  price       Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("outfit_items")
}

model OutfitImage {
  id       String @id @default(cuid())
  outfitId String
  outfit   Outfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)

  url     String
  altText String
  caption String?
  order   Int    @default(0)

  // Image metadata
  width  Int
  height Int
  format String
  size   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("outfit_images")
}

// Interactive Features Models
model Poll {
  id                 String   @id @default(cuid())
  question           String
  description        String?
  allowMultipleVotes Boolean  @default(false)
  isActive           Boolean  @default(true)
  expiresAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  options  PollOption[]
  votes    Vote[]

  @@map("polls")
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  text      String
  image     String?
  order     Int     @default(0)
  voteCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  votes Vote[]

  @@map("poll_options")
}

model Vote {
  id       String @id @default(cuid())
  pollId   String
  poll     Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([pollId, userId, optionId])
  @@map("votes")
}

model Comment {
  id          String  @id @default(cuid())
  contentId   String
  contentType CommentContentType
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  content    String
  parentId   String?
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[] @relation("CommentReplies")
  
  likes        Int     @default(0)
  isModerated  Boolean @default(false)
  isApproved   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comments")
}

// Donation Models
model Donation {
  id              String        @id @default(cuid())
  amount          Float
  currency        String        @default("USD")
  isRecurring     Boolean       @default(false)
  status          DonationStatus @default(PENDING)
  paymentIntentId String        @unique

  // Donor information
  donorName      String?
  donorEmail     String?
  donorMessage   String?
  isAnonymous    Boolean       @default(false)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@map("donations")
}

model DonationGoal {
  id            String    @id @default(cuid())
  title         String
  description   String
  targetAmount  Float
  currentAmount Float     @default(0)
  isActive      Boolean   @default(true)
  deadline      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("donation_goals")
}

// Notification Models
model Notification {
  id      String           @id @default(cuid())
  userId  String
  type    NotificationType
  title   String
  message String
  data    Json?
  isRead  Boolean          @default(false)

  createdAt DateTime @default(now())

  @@map("notifications")
}

// This or That Models
model ThisOrThat {
  id        String   @id @default(cuid())
  title     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  votes ThisOrThatVote[]

  // Option A
  optionAImage String
  optionALabel String
  optionAVotes Int    @default(0)

  // Option B
  optionBImage String
  optionBLabel String
  optionBVotes Int    @default(0)

  @@map("this_or_that")
}

model ThisOrThatVote {
  id           String      @id @default(cuid())
  questionId   String
  question     ThisOrThat  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  visitorId    String
  choice       String      // 'A' or 'B'
  createdAt    DateTime    @default(now())

  @@unique([questionId, visitorId])
  @@map("this_or_that_votes")
}

// Enums
enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum ContentSectionType {
  DAILY_ACTIVITY
  CLOSET
  OUTFIT
  DINING
  SNACKS
  FUN_FACTS
  MENA_WATCHLIST
}

enum OutfitItemCategory {
  DRESS
  TOP
  BOTTOM
  SHOES
  ACCESSORY
  JEWELRY
}

enum CommentContentType {
  CONTENT_SECTION
  OUTFIT
  POLL
  GENERAL
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum NotificationType {
  NEW_CONTENT
  COMMENT_REPLY
  COMMENT_MENTION
  POLL_RESULT
  DONATION_RECEIVED
  SYSTEM
}
